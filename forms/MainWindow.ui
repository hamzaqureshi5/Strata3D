     <property name="styleSheet">
      <string notr="true">QProgressBar {
    /* Background for the whole progress bar */
    background-color: #3a3a3a; /* Darker gray to stand out on a gray background */
    border: 1px solid #555; /* Slightly lighter gray border */
    border-radius: 10px; /* Rounded corners */
    text-align: center; /* Center the text */
    color: white; /* White text color */
    font: bold 12pt &quot;Arial&quot;; /* Font style */
}

QProgressBar::chunk {
    /* Background for the progress portion */
    background-color: #76c7c0; /* Pleasant green */
    border-radius: 10px; /* Rounded corners */
    margin: 1px; /* Space between chunks */
}
</string>
