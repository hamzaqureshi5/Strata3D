      <item row="19" column="1">
       <widget class="QPushButton" name="exportSTL">
        <property name="styleSheet">
         <string notr="true">QPushButton {
    /* Gradient background */
    background-color: rgba(0, 116, 255, 255);
    background-image: linear-gradient(to bottom, rgba(0, 116, 255, 255), rgba(0, 80, 200, 255));
    
    /* White text color */
    color: white;

    /* Font style */
    font: 12pt &quot;Arial&quot;;
    font-weight: bold;

    /* Button styling */
    border-radius: 8px; /* Rounded corners */
    border: 1px solid black;
    padding: 10px 20px; /* Increased padding for better appearance */
    
    /* Box shadow for depth */
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
}

QPushButton:hover {
    /* Lighter gradient on hover */
    background-color: rgba(0, 140, 255, 255);
    background-image: linear-gradient(to bottom, rgba(0, 140, 255, 255), rgba(0, 90, 200, 255));
    
    /* Slightly larger shadow */
    box-shadow: 4px 4px 7px rgba(0, 0, 0, 0.4);
}

QPushButton:pressed {
    /* Darker color and inset shadow on press */
    background-color: rgb(65, 79, 72);
    background-image: none;
    box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.5);
    
    /* Slightly reduce padding to simulate button press */
    padding: 9px 19px;
}
</string>
        </property>
        <property name="text">
         <string>EXPORT STL</string>
        </property>
       </widget>
