       <widget class="QSlider" name="horizontalSlider">
        <property name="styleSheet">
         <string notr="true">QSlider::groove:horizontal {
    background-color: #dddddd; /* Background color of the slider groove */
    height: 8px; /* Height of the groove */
    border-radius: 4px; /* Rounded corners of the groove */
}

QSlider::handle:horizontal {
    background-color: #2196F3; /* Color of the slider handle */
    border: 1px solid #cccccc; /* Border around the handle */
    width: 8px; /* Width of the handle */
    margin: -10px 0; /* Center the handle vertically */
    border-radius: 10px; /* Rounded corners of the handle */
}</string>
