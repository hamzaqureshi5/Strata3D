     <property name="styleSheet">
      <string notr="true">/* Slider Groove */
QSlider::groove:vertical {
    background-color: #dddddd; /* Background color of the slider groove */
    width: 8px; /* Width of the groove */
    border-radius: 4px; /* Rounded corners of the groove */
}

/* Slider Handle */
QSlider::handle:vertical {
    background-color: #2196F3; /* Color of the slider handle */
    border: 1px solid #cccccc; /* Border around the handle */
    height: 10px; /* Height of the handle */
width:40px    ;
margin: 0 -6px; /* Center the handle horizontally */
    border-radius: 1px; /* Rounded corners of the handle */
}

/* Slider Handle when pressed */
QSlider::handle:vertical:pressed {
    background-color: #1e88e5; /* Darker shade of blue when pressed */
}
</string>
