     <property name="styleSheet">
      <string notr="true">QPushButton {
    color: #0074ff; /* Blue text color */
    background-color: transparent; /* Transparent background */
    font: 12pt &quot;Arial&quot;;
    font-weight: bold;
    border-radius: 10px; /* Rounded corners */
    /*border: 2px solid #0074ff; /* Blue border */
    padding: 10px 20px; /* Increased padding for better appearance */
    
    /* Smooth transition for background and border color */
    transition: background-color 0.3s, border-color 0.3s;
}

QPushButton:hover {
    /* Light gray background on hover */
   /* background-color: rgba(224, 224, 224, 0.5);*/
    border-color: #005fcc;
}

QPushButton:pressed {
    /* Slightly darker background when pressed */
    background-color: rgba(191, 191, 191, 0.5);
    border-color: #003f99;
    
    /* Slightly reduce padding to simulate button press */
    padding: 9px 19px;
}
</string>
