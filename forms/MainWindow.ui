          <property name="styleSheet">
           <string notr="true">QPushButton {
    /* Transparent background with blue border and text */
    color: #0074ff;
    background-color: transparent;
    font: 10pt &quot;Arial&quot;;
    font-weight: bold;
    border-radius: 8px; /* Slightly rounded corners */
    border: 2px solid #0074ff;
    padding: 10px 20px; /* Increased padding for better appearance */
    
    /* Smooth transition for background and border color */
    transition: background-color 0.3s, border-color 0.3s;
}

QPushButton:hover {
    /* Dark gray background and lighter border on hover */
    background-color: rgba(63, 63, 63, 0.1);
    border-color: #005fcc;
}

QPushButton:pressed {
    /* Dark green background and blue border on press */
    background-color: rgba(65, 79, 72, 0.2);
    border-color: #003f99;
    
    /* Slightly reduce padding to simulate button press */
    padding: 9px 19px;
}
</string>
